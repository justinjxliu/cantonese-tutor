{
  "templates": {
    "state": {
      "phrase": "I am {english}",
      "characters": "我{cantonese}",
      "jyutping": "ngo5 {jyutping}",
      "vocabulary": ["ngo5_I"],
      "pronunciation": ["ngo5_I"],
      "mode": "append",
      "grammar": "Cantonese often omits 'to be'. Instead of saying 'I am {english}', you say 'I {english}'. In Cantonese, this is 我{cantonese}.",
      "practice": [
        {
          "phrase": "I am {english} now",
          "characters": "我而家{cantonese}",
          "jyutping": "ngo5 ji4 gaa1 {jyutping}"
        },
        {
          "phrase": "I am not {english}",
          "characters": "我唔{cantonese}",
          "jyutping": "ngo5 m4 {jyutping}"
        },
        {
          "phrase": "Are you {english}",
          "characters": "你{cantonese}呀",
          "jyutping": "nei5 {jyutping} aa3"
        },
        {
          "phrase": "I'm not {english} this morning",
          "characters": "我今朝唔{cantonese}",
          "jyutping": "ngo5 gam1 ziu1 m4 {jyutping}"
        },
        {
          "phrase": "Are they {english}",
          "characters": "佢哋{cantonese}呀",
          "jyutping": "keoi5 dei6 {jyutping} aa3"
        }
      ]
    },
    "intensifier": {
      "phrase": "I am very {english}",
      "characters": "我好{cantonese}",
      "jyutping": "ngo5 hou2 {jyutping}",
      "vocabulary": ["ngo5_I", "hou2_very"],
      "pronunciation": ["ngo5_I", "hou2_very"],
      "mode": "append",
      "grammar": "In Cantonese, adjectives often use '好'. So 'I am very {english}' becomes 我好{cantonese}.",
      "practice": [
        {
          "phrase": "I am very {english} right now",
          "characters": "我而家好{cantonese}",
          "jyutping": "ngo5 ji4 gaa1 hou2 {jyutping}"
        },
        {
          "phrase": "You are very {english}",
          "characters": "你好{cantonese}",
          "jyutping": "nei5 hou2 {jyutping}"
        },
        {
          "phrase": "She is very {english}",
          "characters": "佢好{cantonese}",
          "jyutping": "keoi5 hou2 {jyutping}"
        },
        {
          "phrase": "We are very {english}",
          "characters": "我哋好{cantonese}",
          "jyutping": "ngo5 dei6 hou2 {jyutping}"
        },
        {
          "phrase": "They are very {english}",
          "characters": "佢哋好{cantonese}",
          "jyutping": "keoi5 dei6 hou2 {jyutping}"
        }
      ]
    },
    "happened": {
      "phrase": "I {english}",
      "characters": "我{cantonese}咗",
      "jyutping": "ngo5 {jyutping} zo2",
      "vocabulary": ["ngo5_I", "VERB", "zo2_completed"],
      "pronunciation": ["ngo5_I", "VERB", "zo2_completed"],
      "mode": "replace",
      "grammar": "Cantonese uses '咗' to indicate completion of an action. It means 'already did'. So 'I {english}' becomes 我{cantonese}咗, meaning the action has been completed.",
      "practice": [
        {
          "phrase": "I {english} yesterday",
          "characters": "我尋日{cantonese}咗",
          "jyutping": "ngo5 cam4 jat6 {jyutping} zo2"
        },
        {
          "phrase": "I think I {english}",
          "characters": "我好似{cantonese}咗",
          "jyutping": "ngo5 hou2 ci5 {jyutping} zo2"
        },
        {
          "phrase": "I {english} so I can't go out today",
          "characters": "我{cantonese}咗，所以今日出唔到街",
          "jyutping": "ngo5 {jyutping} zo2 so2 ji5 gam1 jat6 ceot1 m4 dou2 gaai1"
        }
      ]
    },
    "experienced": {
      "phrase": "I have {english}",
      "characters": "我{cantonese}過",
      "jyutping": "ngo5 {jyutping} gwo3",
      "vocabulary": ["ngo5_I", "VERB", "gwo3_experienced"],
      "pronunciation": ["ngo5_I", "VERB", "gwo3_experienced"],
      "mode": "replace",
      "grammar": "Cantonese uses '過' to mark that an action or state has been experienced at least once. It does not express tense or completion, but general experience (similar to 'ever' in English).",
      "practice": [
        {
          "phrase": "I have {english} at least once",
          "characters": "我最少{cantonese}過一次",
          "jyutping": "ngo5 zeoi3 siu2 {jyutping} gwo3 jat1 ci3"
        },
        {
          "phrase": "I have never {english}",
          "characters": "我未{cantonese}過",
          "jyutping": "ngo5 mei6 {jyutping} gwo3"
        },
        {
          "phrase": "Have you ever {english}",
          "characters": "你有冇{cantonese}過？",
          "jyutping": "nei5 jau5 mou5 {jyutping} gwo3"
        },
        {
          "phrase": "I have {english} many times before",
          "characters": "我試過好多次{cantonese}",
          "jyutping": "ngo5 si3 gwo3 hou2 do1 ci3 {jyutping}"
        }
      ]
    },
    "planned": {
      "phrase": "I will {english}",
      "characters": "我會{cantonese}",
      "jyutping": "ngo5 wui5 {jyutping}",
      "vocabulary": ["ngo5_I", "wui5_will"],
      "pronunciation": ["ngo5_I", "wui5_will"],
      "mode": "append",
      "grammar": "Cantonese uses '會' to indicate future intention or expectation. It expresses that an action will likely happen, without needing a separate tense system.",
      "practice": [
        {
          "phrase": "I will {english} tomorrow",
          "characters": "我聽日會{cantonese}",
          "jyutping": "ngo5 ting1 jat6 wui5 {jyutping}"
        },
        {
          "phrase": "I think I will {english}",
          "characters": "我覺得我會{cantonese}",
          "jyutping": "ngo5 gok3 dak1 ngo5 wui5 {jyutping}"
        },
        {
          "phrase": "I will {english} later",
          "characters": "我遲啲會{cantonese}",
          "jyutping": "ngo5 ci4 di1 wui5 {jyutping}"
        },
        {
          "phrase": "I will probably {english}",
          "characters": "我可能會{cantonese}",
          "jyutping": "ngo5 ho2 nang4 wui5 {jyutping}"
        }
      ]
    },
    "want": {
      "phrase": "I want to {english}",
      "characters": "我想{cantonese}",
      "jyutping": "ngo5 soeng2 {jyutping}",
      "vocabulary": ["ngo5_I", "soeng2_want"],
      "pronunciation": ["ngo5_I", "soeng2_want"],
      "mode": "append",
      "grammar": "Cantonese uses '想' (soeng2) to express 'want to'. It is placed directly before a verb, without needing 'to' like in English. So 'I want {english}' becomes 我想{cantonese}.",
      "practice": [
        {
          "phrase": "I really want to {english} today",
          "characters": "我今日真係想{cantonese}",
          "jyutping": "ngo5 gam1 jat6 zan1 hai6 soeng2 {jyutping}"
        },
        {
          "phrase": "I don't want to {english} because it's too cold",
          "characters": "太凍，我唔想{cantonese}",
          "jyutping": "taai3 dung3 ngo5 m4 soeng2 {jyutping}"
        },
        {
          "phrase": "I still don't want to {english}",
          "characters": "我都唔想{cantonese}",
          "jyutping": "ngo5 dou1 m4 soeng2 {jyutping}"
        },
        {
          "phrase": "I want to {english} now",
          "characters": "我而家想{cantonese}",
          "jyutping": "ngo5 ji4 gaa1 soeng2 {jyutping}"
        }
      ]
    },
    "imminent": {
      "phrase": "I am about to {english}",
      "characters": "我就嚟{cantonese}",
      "jyutping": "ngo5 zau6 lai4 {jyutping}",
      "vocabulary": ["ngo5_I", "zau6_lai4_almost"],
      "pronunciation": ["ngo5_I", "zau6_just", "lai4_come"],
      "mode": "append",
      "grammar": "Cantonese uses '就嚟' (zau6 lai4) to express that something is about to happen very soon. It is placed before the verb phrase to indicate imminent action.",
      "practice": [
        {
          "phrase": "I am about to {english} now",
          "characters": "我而家就嚟{cantonese}",
          "jyutping": "ngo5 ji4 gaa1 zau6 lai4 {jyutping}"
        },
        {
          "phrase": "I am about to {english}, wait a moment",
          "characters": "我就嚟{cantonese}，等陣",
          "jyutping": "ngo5 zau6 lai4 {jyutping}, dang2 zan6"
        },
        {
          "phrase": "I am about to {english} so I can't talk",
          "characters": "我就嚟{cantonese}，所以唔可以講嘢",
          "jyutping": "ngo5 zau6 lai4 {jyutping}, so2 ji5 m4 ho2 ji5 gong2 je5"
        },
        {
          "phrase": "I am about to {english}, don't disturb me",
          "characters": "我就嚟{cantonese}，唔好煩我",
          "jyutping": "ngo5 zau6 lai4 {jyutping}, m4 hou2 faan4 ngo5"
        }
      ]
    },
    "like": {
      "phrase": "I like {english}",
      "characters": "我鍾意{cantonese}",
      "jyutping": "ngo5 zung1 ji3 {jyutping}",
      "vocabulary": ["ngo5_I", "zung1_ji3_like"],
      "pronunciation": ["ngo5_I", "zung1_focus", "ji3_thought"],
      "mode": "append",
      "grammar": "Cantonese uses '鍾意' (zung1 ji3) to express 'like'. It is placed directly before a noun or verb, without needing extra words. So 'I like {english}' becomes 我鍾意{cantonese}.",
      "practice": [
        {
          "phrase": "I like {english} in the morning",
          "characters": "我朝早鍾意{cantonese}",
          "jyutping": "ngo5 ziu1 zou2 zung1 ji3 {jyutping}"
        },
        {
          "phrase": "I really like {english}",
          "characters": "我真係鍾意{cantonese}",
          "jyutping": "ngo5 zan1 hai6 zung1 ji3 {jyutping}"
        },
        {
          "phrase": "I don't like {english} when it's cold",
          "characters": "凍嘅時候我唔鍾意{cantonese}",
          "jyutping": "dung3 ge3 si4 hau6 ngo5 m4 zung1 ji3 {jyutping}"
        }
      ]
    },
    "where": {
      "phrase": "Where is {english}",
      "characters": "{cantonese}喺邊度",
