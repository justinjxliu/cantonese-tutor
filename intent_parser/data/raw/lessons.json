    "id": "lesson_001_hungry",
    "english": "I am hungry",
    "chinese": "我肚餓",
    "jyutping": "ngo5 tou5 ngo6",
    "vocabulary": ["ngo5_I", "tou5_ngo6_hungry"],
    "pronunciation": ["ngo5_I", "tou5_stomach", "ngo6_hungry"],
    "grammar": "Cantonese often omits 'to be' in simple descriptions. Instead of saying 'I am hungry', you simply say 'I hungry'. This is normal and natural in Cantonese.",
    "practice": [
      {
        "type": "applicative",
        "chinese": "我而家肚餓",
        "jyutping": "ngo5 ji4 gaa1 tou5 ngo6",
        "english": "I am hungry now"
      },
      {
        "type": "negative",
        "chinese": "我唔肚餓",
        "jyutping": "ngo5 m4 tou5 ngo6",
        "english": "I am not hungry"
      },
      {
        "type": "interrogative",
        "chinese": "你肚唔肚餓",
        "jyutping": "nei5 tou5 m4 tou5 ngo6",
        "english": "Are you hungry"
      }
    ]
  },
